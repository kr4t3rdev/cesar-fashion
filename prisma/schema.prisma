generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  emailVerified DateTime?
  image         String?
  password      String?
  role            String    @default("admin")
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  products        Product[]
  combos          Combo[]
  wholesaleSales  WholesaleSale[]
  accounts        Account[]
  sessions        Session[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@id([identifier, token])
}

model Product {
  id          String   @id @default(cuid())
  name        String
  description String
  category    String
  price       Decimal  @db.Decimal(10, 2)
  salePrice   Decimal? @db.Decimal(10, 2)
  currency    String   @default("USD")
  stock       Int      @default(0)
  imageUrl    String?
  isOnSale              Boolean  @default(false)
  saleLabel             String?
  featured              Boolean  @default(false)
  isWholesale           Boolean  @default(false)
  wholesaleUnitName     String?
  wholesaleUnitQuantity Int      @default(1)
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt
  createdById           String?
  createdBy             User?    @relation(fields: [createdById], references: [id])

  comboItems      ComboItem[]
  wholesaleSales  WholesaleSale[]

  @@index([isOnSale])
  @@index([category])
  @@index([featured])
}

model Combo {
  id          String   @id @default(cuid())
  name        String
  description String
  price       Decimal  @db.Decimal(10, 2)
  salePrice   Decimal? @db.Decimal(10, 2)
  currency    String   @default("USD")
  imageUrl    String?
  isOnSale    Boolean  @default(false)
  saleLabel   String?
  featured    Boolean  @default(false)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  createdById String?
  createdBy   User?    @relation(fields: [createdById], references: [id])

  items ComboItem[]

  @@index([isActive])
  @@index([featured])
}

model ComboItem {
  id        String @id @default(cuid())
  comboId   String
  combo     Combo   @relation(fields: [comboId], references: [id], onDelete: Cascade)
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  quantity  Int     @default(1)

  @@unique([comboId, productId])
}

model WholesaleSale {
  id            String   @id @default(cuid())
  productId     String
  product       Product  @relation(fields: [productId], references: [id])
  unitName      String
  piecesPerUnit Int
  units         Int
  pieces        Int
  pricePerUnit  Decimal  @db.Decimal(10, 2)
  total         Decimal  @db.Decimal(10, 2)
  customer      String?
  note          String?
  createdById   String?
  createdBy     User?    @relation(fields: [createdById], references: [id])
  createdAt     DateTime @default(now())

  @@index([createdAt])
  @@index([productId])
}
